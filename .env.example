# Node settings
NODE_ENV=production
# Timezone application is in
TZ="Europe/Paris"

# Proxy settings
# http_proxy=
# https_proxy=
# no_proxy=
# Force usage of $http_proxy, $https_proxy and $no_proxy
NODE_USE_ENV_PROXY=1

# How the internal RP should resolve hosts -> Docker: 127.0.0.11 | Podman: 10.89.0.1
NGINX_RESOLVER=127.0.0.11
# How the internal RP should serve ezMESURE -> http | https
NGINX_PROTOCOL=http

# Required status of the ElasticSearch cluster -> green | yellow | red
ELASTICSEARCH_REQUIRED_STATUS=green
# Connection options of the ElasticSearch cluster
# Option 1: Set every part of URL
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_HOST=elastic.localhost
ELASTICSEARCH_PORT=9200
# Option 2: Set the full URL
# ELASTICSEARCH_URL=http://elastic.localhost:9200
# Credentials used to administrate the ElasticSearch cluster
EZMESURE_ELASTICSEARCH_USERNAME=elastic
EZMESURE_ELASTICSEARCH_PASSWORD=changeme
# Credentials used to generate reports
# Set this to a user having "run_as" and "monitor" privileges on the ElasticSearch Cluster
# Option 1: Set username/password
EZREEPORT_ELASTICSEARCH_USERNAME=elastic
EZREEPORT_ELASTICSEARCH_PASSWORD=changeme
# Option 2: Set API Key generated from cluster
# EZREEPORT_ELASTICSEARCH_API_KEY=

# Connection options of Kibana (on the same ElasticSearch cluster)
# Option 1: Set every part of URL
KIBANA_HOST=kibana.localhost
KIBANA_PORT=5601
# Option 2: Set the full URL
# KIBANA_URL=http://kibana.localhost:5601
# Credentials used to administrate Kibana
# Note that the API will change the password for this user to the one provided
EZMESURE_KIBANA_USERNAME=kibana_system
EZMESURE_KIBANA_PASSWORD=changeme

# Connection options of Redis
REDIS_HOST=redis
REDIS_PORT=6379
# Password to protect redis instance
REDIS_PASSWORD=changeme

# Connection options of mail server
SMTP_HOST=smtp.localhost
SMTP_PORT=25
# Should use TLS immediately -> Set to "true" if using port 465, "false" (auto) otherwise
SMTP_SECURE=false
# Should ignore TLS support -> Set to "false" to use TLS (if available)
SMTP_IGNORE_TLS=false
# Should reject invalid TLS certificates
SMTP_REJECT_UNAUTHORIZED=false

# Connection options of Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Database name of data related to ezMESURE
EZMESURE_POSTGRES_DB=ezmesure
# Database name of data related to ezREEPORT
EZREEPORT_POSTGRES_DB=ezreeport
# Credentials used to connect to Postgres
# Set this to a user having rights on $EZMESURE_POSTGRES_DB and $EZREEPORT_POSTGRES_DB database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Connection options of RabbitMQ
RABBITMQ_PROTOCOL=amqp
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# Credentials used to connect to RabbitMQ for ezREEPORT's internal communication
EZREEPORT_RABBITMQ_USERNAME=guest
EZREEPORT_RABBITMQ_PASSWORD=guest
# VHost to use for ezREEPORT's internal communication
EZREEPORT_RABBITMQ_VHOST="/"

# Mail address to use when ezMESURE send mails
EZMESURE_NOTIFICATIONS_SENDER="ezMESURE <noreply@ezmesure.localhost>"
# Mail address to use when ezREEPORT send reports
EZREEPORT_EMAIL_SENDER="ezREEPORT <noreply@ezreeport.localhost>"
# Mail address to add as a "reply-to" header
EZMESURE_NOTIFICATIONS_REPLY_TO=""
# Mail address to send reports errors and fails
EZREEPORT_EMAIL_SUPPORT_TEAM=
# Cron expression defining how often to send recent activity
EZMESURE_NOTIFICATIONS_CRON="" # Use app default (Default: every day at 12pm)
# Should send the recent activity even if empty
EZMESURE_SEND_EMPTY_ACTIVITY=true
# Cron expression defining how often the summary of sent mails is sent
EZMESURE_EMAILS_SUMMARY_SCHEDULE="" # Use app default (Default: every day at 12pm)
# Cron expression defining how often the sent mails are cleared
EZMESURE_EMAILS_CLEANUP_SCHEDULE="" # Use app default (Default: every day at 12pm)
# Max age (in days) of "outgoing-mails"
EZMESURE_EMAILS_CLEANUP_MAX_DAY_AGE="" # Use app default (Default: 10000)

# The public domain of your ezMESURE instance
EZMESURE_DOMAIN=ezmesure.localhost
# The public port needed to access your ezMESURE instance (you can skip it if using 80 on HTTP and 443 on HTTPS)
EZMESURE_PUBLIC_PORT=":8880"
# App name (used in mails)
EZMESURE_APP_NAME=ezMESURE
# Adds name of instance under logo, useful when hosting many instances
EZMESURE_CURRENT_INSTANCE=""

# Default locale of the app
EZMESURE_DEFAULT_LOCALE=fr

# Secret to sign JWT used to interact with the API
# Needs to be 32bytes
EZMESURE_AUTH_SECRET=d7a8c699c63836b837af086cfb3441cbcfcf1a02
# Name of the token containing auth session token
EZMESURE_AUTH_COOKIE=eztoken

# Key to interact with ezREEPORT admin API, ezMESURE uses it to sync data
EZREEPORT_ADMIN_KEY=00000000-0000-0000-0000-000000000000

# client_id given by the provider
EZMESURE_OIDC_CLIENT_ID="<client_id from provider>"
# client_sercret given by the provider
EZMESURE_OIDC_CLIENT_SECRET="<client_secret from provider>"

# If your OpenID provider supports discovery:
EZMESURE_OIDC_DISCOVERY_URI=https://auth.localhost/.well-known/openid-configuration

# If your OpenID provider DOES NOT supports discovery:
# EZMESURE_OIDC_ISSUER_URI=https://auth.localhost
# EZMESURE_OIDC_AUTH_URI=https://auth.localhost/auth
# EZMESURE_OIDC_TOKEN_URI=https://auth.localhost/token
# EZMESURE_OIDC_INTROSPECTION_URI=https://auth.localhost/token/introspect
# EZMESURE_OIDC_REVOCATION_URI=https://auth.localhost/token/revoke
# EZMESURE_OIDC_USERINFO_URI=https://auth.localhost/userinfo

# scopes to request to the provider, this is the default value
EZMESURE_OIDC_SCOPES=["openid","profile","email","offline_access"]

# Data for the default user (app admin)
# Should match someone in your IDP to allow login
EZMESURE_ADMIN_USERNAME=admin
EZMESURE_ADMIN_FULLNAME=ezmesure-admin
EZMESURE_ADMIN_EMAIL=admin@ezmesure.localhost

# Port that ezMESURE API will listen
EZMESURE_PORT=3000

# Cron expression defining how often ezMESURE should sync it's data to ElasticSearch
EZMESURE_ELASTIC_SYNC_SCHEDULE="" # Use app default (Default: everyday at 12am)
# Cron expression defining how often ezMESURE should sync it's data to Kibana
EZMESURE_KIBANA_SYNC_SCHEDULE="" # Use app default (Default: everyday at 12am)
# Cron expression defining how often ezMESURE should sync it's data to ezREEPORT
EZMESURE_REPORT_SYNC_SCHEDULE="" # Use app default (Default: everyday at 12am)

# Default date format for Kibana spaces
EZMESURE_KIBANA_DATE_FORMAT="DD MM YYYY"

# ezPAARSE uploads settings
EZMESURE_EZPAARSE_UPLOAD_BULK_SIZE="" # Use app default (Default: 2000)
EZMESURE_EZPAARSE_UPLOAD_BULK_MAX_TRIES="" # Use app default (Default: 5)
EZMESURE_EZPAARSE_UPLOAD_BULK_BASE_RETRY_DELAY="" # Use app default (Default: 1000)

# How many harvest jobs should be started at once
EZMESURE_HARVEST_CONCURRENCY="" # Use app default (Default: 1)
# How many times an harvest job can be delayed
EZMESURE_MAX_DEFERRALS="" # Use app default (Default: 5)
# Duration of the delay when a endpoint ask to come back later
EZMESURE_DEFERRAL_BACKOFF_DURATION="" # Use app default (Default: 600)
# Duration of the delay when a endpoint is busy
EZMESURE_BUSY_BACKOFF_DURATION="" # Use app default (Default: 600)
# List of standard COUNTER report
EZMESURE_DEFAULT_HARVESTED_REPORTS="" # Use app default (Default: ["dr","dr_d1","ir","pr","pr_p1","tr","tr_b1","tr_j1"])
# Cron expression defining how often ezMESURE should check for dangling harvest job
EZMESURE_HARVEST_CANCEL_SCHEDULE="" # Use app default (Default: everyday at 12am)
# Cron expression defining how often ezMESURE should clean downloaded reports
EZMESURE_CLEAN_COUNTER_SCHEDULE="" # Use app default (Default: everyday at 12am)
# Max age of downloaded reports
EZMESURE_COUNTER_MAX_AGE="" # Use app default (Default: 7)

# Cron expression defining how often ezMESURE should check for deleted COUNTER credentials
EZMESURE_DELETE_SUSHI_COUNTER_SCHEDULE="" # Use app default (Default: every 15mins)
# Interval to follow COUNTER credential data deletion (in ms)
EZMESURE_DELETE_SUSHI_COUNTER_FOLLOW_INTERVAL="" # Use app default (Default: 10000)

# Cron expression defining how often ezMESURE should check for COUNTER alerts
EZMESURE_SUSHI_ALERT_HARVESTED_BUT_UNSUPPORTED_SCHEDULE="" # Use app default (default: every sunday at 12am)
EZMESURE_SUSHI_ALERT_ENDPOINT_SCHEDULE="" # Use app default (default: everyday at 12am)

# How many days ezMESURE should wait before hard deleting users
EZMESURE_USERS_DELETE_DURATION_DAYS="" # Use app default (Default: 7)
# Cron expression defining how often ezMESURE should check for deleted users
EZMESURE_USERS_CLEAN_SCHEDULE="" # Use app default (Default: everyday at 12am)
# Duration of a impersonate session
EZMESURE_USERS_IMPERSONATE_DURATION_SECONDS="" # Use app default (Default: 10800)

# Cache settings
EZMESURE_CACHE_DURATION_LOGIN_STATE="" # Use app default (Default: 3600000)
EZMESURE_CACHE_DURATION_HARVEST_MATRIX="" # Use app default (Default: 600000)
EZMESURE_CACHE_DURATION_HARVEST_SESSION_JOBS="" # Use app default (Default: 300000)
EZMESURE_CACHE_DURATION_HARVEST_SESSION_STATUS="" # Use app default (Default: 3600000)
EZMESURE_CACHE_DURATION_INSTITUTION_HARVESTABLE="" # Use app default (Default: 300000)
EZMESURE_CACHE_DURATION_INSTITUTION_REPORTING="" # Use app default (Default: 86400000)
EZMESURE_CACHE_DURATION_COUNTER_REGISTRY="" # Use app default (Default: 86400000)

# Log level of ezMESURE
EZMESURE_LOG_LEVEL=info
# How many lines should be buffered to be visible for frontend
EZMESURE_LOG_BUFFER_SIZE="" # Use app default (Default: 500)
# nb de connexions au sse
EZMESURE_SSE_LOGS_MAX_POOL_SIZE="" # Use app default (Default: 20)
# interval du heartbeat pour garde connexion active
EZMESURE_SSE_LOGS_HEARTBEAT_INTERVAL="" # Use app default (Default: 10000)

# URL towards the COUNTER Registry
EZMESURE_COUNTER_REGISTRY_URL="" # Use app default (Default: https://registry.countermetrics.org)

# Select which feature should be shown in homepage
EZMESURE_HOMEPAGE_FEATURES="" # Use app default (Default: ['dashboard', 'repository', 'ezpaarse', 'counter', 'reporting'])
# Select which logo should be shown in homepage
EZMESURE_HOMEPAGE_LOGOS="" # Use app default (Default: ['slsp','csal','epfl','unige','cnrs','couperin'])

# Port that ezREEPORT API will listen
EZREEPORT_PORT=8080
# Allowed origins (CORS) to access ezREEPORT API
EZREEPORT_ALLOWED_ORIGINS="" # Use app default (Default: *)
# Allowed proxies to access ezREEPORT API
EZREEPORT_ALLOWED_PROXIES="" # Use app default (Default: *)

# Domains where ezREEPORT shouldn't query assets
EZREEPORT_FETCHER_BANNED_DOMAINS="" # Use app default (Default: [])

# Language of default report template
EZREEPORT_DEFAULT_TEMPLATE_LOCALE=fr
# Date field of default report template
EZREEPORT_DEFAULT_TEMPLATE_DATEFIELD="" # Use app default (Default: datetime)
# Name of the default report template
EZREEPORT_DEFAULT_TEMPLATE_NAME=scratch

# How many iterations of the report should be kept
EZREEPORT_ITERATIONS_TO_LIVE="" # Use app default (Default: 4)
# How many days a report should live
EZREEPORT_DAYS_TO_LIVE="" # Use app default (Default: 7)

# Cron expression defining how often ezREEPORT should check for new reports
EZREEPORT_TIMER_GENERATE_REPORT="" # Use app default (Default: everyday at 7am)
# Cron expression defining how often ezREEPORT should check for old reports
EZREEPORT_TIMER_PURGE_OLD_REPORT="" # Use app default (Default: everyday at 1am)

# Log level of ezREEPORT
EZREEPORT_LOG_LEVEL=info
# Directory where logs should be written. Not written if empty
EZREEPORT_LOG_DIR=
# Which keys should be ignored from logs
EZREEPORT_LOG_IGNORE="" # Use app default (Default: ["hostname"])

# How often should ezREEPORT send heartbeat (in ms)
EZREEPORT_HEARTBEAT_FREQUENCY="" # Use app default (Default: 5000)
# How often should ezREEPORT send heartbeat for external services when service is responding (in ms)
EZREEPORT_HEARTBEAT_EXTERNAL_FREQUENCY_MAX="" # Use app default (Default: 300000)
# How often should ezREEPORT send heartbeat for external services when service is error (in ms)
EZREEPORT_HEARTBEAT_EXTERNAL_FREQUENCY_MIN="" # Use app default (Default: 5000)
