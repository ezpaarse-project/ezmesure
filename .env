# Node settings
NODE_ENV=production
TZ="Europe/Paris"

# How RP should resolve hosts -> Docker: 127.0.0.11 | Podman: 10.89.0.1
NGINX_RESOLVER=127.0.0.11
# HTTP/HTTPS options - Note that ezMESURE should be served under HTTPS anyway
NGINX_PROTOCOL=http

# Elastic settings
EZMESURE_ELASTICSEARCH_USERNAME=elastic
EZMESURE_ELASTICSEARCH_PASSWORD=changeme
EZREEPORT_ELASTICSEARCH_USERNAME=elastic
EZREEPORT_ELASTICSEARCH_PASSWORD=changeme
# Can set API Key instead of username/password
# EZREEPORT_ELASTICSEARCH_API_KEY=
ELASTICSEARCH_REQUIRED_STATUS=green
# Option 1: Set every part of URL
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_HOST=elastic
ELASTICSEARCH_PORT=9200
# Option 2: Set the URL
# ELASTICSEARCH_URL="https://elastic:9200"

# Kibana settings
EZMESURE_KIBANA_USERNAME=kibana_system
EZMESURE_KIBANA_PASSWORD=changeme
# Option 1: Set every part of URL
KIBANA_HOST=kibana
KIBANA_PORT=5601
# Option 2: Set the URL
# KIBANA_URL="http://kibana:5601"

# Redis settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Postgres settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ezmesure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# RabbitMQ settings
RABBITMQ_PROTOCOL=amqp
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
EZREEPORT_RABBITMQ_USERNAME=guest
EZREEPORT_RABBITMQ_PASSWORD=guest
# EZREEPORT_RABBITMQ_VHOST="/"

# App name
EZMESURE_APP_NAME=ezMESURE
# Public domain of the app
EZMESURE_DOMAIN=ezmesure.localhost
# Adds name of instance under logo, useful when hosting many instances
# EZMESURE_CURRENT_INSTANCE=

# Default locale of the app
EZMESURE_DEFAULT_LOCALE=fr

# Port that API will listen
EZMESURE_PORT=3000

# Default user (app admin) settings
EZMESURE_ADMIN_USERNAME=admin
EZMESURE_ADMIN_FULLNAME=ezmesure-admin
EZMESURE_ADMIN_EMAIL=admin@ezmesure.localhost
EZMESURE_ADMIN_PASSWORD=changeme

# OIDC settings
# EZMESURE_OIDC_PROFILE_PAGE=
EZMESURE_OIDC_CLIENT_ID=ezmesure
EZMESURE_OIDC_CLIENT_SECRET=SuperSecretFromIDP
EZMESURE_OIDC_SCOPES=["openid","profile","email","offline_access"]
# Option 1: Set the discovery URI
EZMESURE_OIDC_DISCOVERY_URI=https://auth.localhost/.well-known/openid-configuration
# Option 2: Set every endpoint URI
# EZMESURE_OIDC_ISSUER_URI=https://auth.localhost
# EZMESURE_OIDC_AUTH_URI=https://auth.localhost/auth
# EZMESURE_OIDC_TOKEN_URI=https://auth.localhost/token
# EZMESURE_OIDC_INTROSPECTION_URI=https://auth.localhost/token/introspect
# EZMESURE_OIDC_REVOCATION_URI=https://auth.localhost/token/revoke
# EZMESURE_OIDC_USERINFO_URI=https://auth.localhost/userinfo

# Mail settings
SMTP_HOST=smtp.localhost
SMTP_PORT=25
# EZMESURE_SMTP_SECURE=false
# EZMESURE_SMTP_IGNORE_TLS=false
# EZMESURE_SMTP_REJECT_UNAUTHORIZED=false
# EZMESURE_EMAILS_SUMMARY_SCHEDULE="0 0 * * * *"
# EZMESURE_EMAILS_CLEANUP_SCHEDULE="0 0 * * * *"
# EZMESURE_EMAILS_CLEANUP_MAX_DAY_AGE=7

# Auth settings
EZMESURE_AUTH_SECRET=d7a8c699c63836b837af086cfb3441cbcfcf1a02
# EZMESURE_AUTH_COOKIE=eztoken

# Proxy settings
# http_proxy=
# https_proxy=
# no_proxy=localhost,kibana,reporting
# NODE_USE_ENV_PROXY=1

# Sync settings
# EZMESURE_ELASTIC_SYNC_SCHEDULE="0 0 0 * * *"
# EZMESURE_KIBANA_SYNC_SCHEDULE="0 0 0 * * *"
# EZMESURE_REPORT_SYNC_SCHEDULE="0 0 0 * * *"

# EZMESURE_KIBANA_DATE_FORMAT="DD MM YYYY"

# ezPAARSE uploads settings
# EZMESURE_EZPAARSE_UPLOAD_BULK_SIZE=2000
# EZMESURE_EZPAARSE_UPLOAD_BULK_MAX_TRIES=5
# EZMESURE_EZPAARSE_UPLOAD_BULK_BASE_RETRY_DELAY=1000

# Harvest settings
# EZMESURE_HARVEST_CONCURRENCY=1
# EZMESURE_MAX_DEFERRALS=5
# EZMESURE_DEFERRAL_BACKOFF_DURATION=600
# EZMESURE_BUSY_BACKOFF_DURATION=600
# EZMESURE_HARVEST_CANCEL_SCHEDULE="0 0 0 * * *"
# EZMESURE_DEFAULT_HARVESTED_REPORTS=["dr","dr_d1","ir","pr","pr_p1","tr","tr_b1","tr_j1"]
# EZMESURE_CLEAN_COUNTER_SCHEDULE="0 0 0 * * *"
# EZMESURE_COUNTER_MAX_AGE=7

# SUSHI credentials settings
# EZMESURE_DELETE_SUSHI_COUNTER_SCHEDULE="0 */15 * * * *"
# EZMESURE_DELETE_SUSHI_COUNTER_FOLLOW_INTERVAL=10000

# SUSHI alerts settings
# EZMESURE_SUSHI_ALERT_HARVESTED_BUT_UNSUPPORTED_SCHEDULE="0 0 0 * * 0"
# EZMESURE_SUSHI_ALERT_ENDPOINT_SCHEDULE="0 0 0 * * *"

# Users settings
# EZMESURE_USERS_DELETE_DURATION_DAYS=7
# EZMESURE_USERS_CLEAN_SCHEDULE="0 0 0 * * *"
# EZMESURE_USERS_IMPERSONATE_DURATION_SECONDS=10800

# Notifications settings
# EZMESURE_NOTIFICATIONS_SENDER="ezMESURE <noreply@ezmesure.localhost>"
# EZMESURE_NOTIFICATIONS_CRON="0 0 0 * * *"
# EZMESURE_NOTIFICATIONS_REPLY_TO=
# EZMESURE_SEND_EMPTY_ACTIVITY=true

# Cache settings
# EZMESURE_CACHE_DURATION_LOGIN_STATE=3600000
# EZMESURE_CACHE_DURATION_HARVEST_MATRIX=600000
# EZMESURE_CACHE_DURATION_HARVEST_SESSION_JOBS=300000
# EZMESURE_CACHE_DURATION_HARVEST_SESSION_STATUS=3600000
# EZMESURE_CACHE_DURATION_INSTITUTION_HARVESTABLE=300000
# EZMESURE_CACHE_DURATION_INSTITUTION_REPORTING=86400000
# EZMESURE_CACHE_DURATION_COUNTER_REGISTRY=86400000

# Log settings
# EZMESURE_LOG_LEVEL=info
# EZMESURE_SSE_LOGS_MAX_POOL_SIZE=20
# EZMESURE_SSE_LOGS_HEARTBEAT_INTERVAL=10000
# EZMESURE_LOG_BUFFER_SIZE=500

# URL towards the COUNTER Registry
# EZMESURE_COUNTER_REGISTRY_URL=https://registry.countermetrics.org

# Homepage options
# EZMESURE_HOMEPAGE_FEATURES=['dashboard', 'repository', 'ezpaarse', 'counter', 'reporting']
# EZMESURE_HOMEPAGE_LOGOS=['slsp','csal','epfl','unige','cnrs','couperin']

# --- ezREEPORT

EZREEPORT_PORT=8080
# EZREEPORT_ALLOWED_ORIGINS=*
# EZREEPORT_ALLOWED_PROXIES=*

EZREEPORT_ADMIN_KEY=00000000-0000-0000-0000-000000000000

# EZREEPORT_FETCHER_BANNED_DOMAINS=[]

EZREEPORT_DEFAULT_TEMPLATE_LOCALE=fr
# EZREEPORT_DEFAULT_TEMPLATE_DATEFIELD=datetime
