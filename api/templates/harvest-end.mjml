{% extends "layout.mjml" %}

{% block title %}
<mj-title>
  {{ t('emails.harvestEnd.title', { institution: '<strong>' + (institution | e) + '</strong>' }) }}
</mj-title>
{% endblock %}

{% block content %}

<mj-section>
  <mj-column>
    <mj-text mj-class="headline">{{ t('emails.harvestEnd.body.headline') }}</mj-text>
  </mj-column>
</mj-section>

<mj-section>
  <mj-column>
    <mj-text>
      {{
      t('emails.harvestEnd.body.p1', {
      institution: '<strong>' + (institution | e) + '</strong>',
      periodStart: '<strong>' + (periodStart | e) + '</strong>',
      periodEnd: '<strong>' + (periodEnd | e) + '</strong>'
      }) | safe
      }}
    </mj-text>

    <mj-text>
      {{ t('emails.harvestEnd.body.p2') }}
    </mj-text>
  </mj-column>
</mj-section>

<mj-section>
  <mj-column>
    {% for list in endpoints %}
    <mj-text font-weight="bold" padding-bottom="0px">
      {{ list[0].endpoint }}
    </mj-text>

    {% for creds in list %}
    <mj-text padding-left="5%" padding-top="0px" padding-bottom="0px">
      {{ creds.package }}

      {% if creds.expired %}
      <span style="color: orange">
        ⚠️ {{ t('emails.harvestEnd.body.outOfDate') }}
      </span>
      {% endif %}
    </mj-text>
    {% endfor %}
    {% endfor %}
  </mj-column>
</mj-section>

<mj-section>
  <mj-column>
    <mj-text>
      {{ t('emails.harvestEnd.body.p3') }}
    </mj-text>

    {% if spaceURL %}
    <mj-button href="{{ spaceURL }}" font-family="Helvetica" background-color="#9c27b0" color="white">
      {{ t('emails.harvestEnd.body.getToYourSpace') }}
    </mj-button>
    {% endif %}

    <mj-text>
      {% if REPLY_TO %}
      {{ t('emails.harvestEnd.body.p4.withoutAddress') }}
      {% else %}
      {{ t('emails.harvestEnd.body.p4.withAddress', { replyTo: (REPLY_TO | e) }) | safe }}
      {% endif %}
    </mj-text>

    <mj-text>
      {{ t('emails.harvestEnd.body.p5', { credentialsURL: (credentialsURL | e) }) | safe }}
    </mj-text>

    <mj-text>
      <p>{{ t('emails.global.regards') }}</p>
      <p>{{ t('emails.global.theTeam') }}</p>
    </mj-text>
  </mj-column>
</mj-section>

{% endblock %}
