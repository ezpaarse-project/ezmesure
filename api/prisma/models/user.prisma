/// A user
model User {
  /// The ID of the user in IDP ("sub" claim of id_token) or generated if not linked
  id                   String        @unique @default(dbgenerated("concat('ezm:', gen_random_uuid())"))
  /// The username
  username             String        @id
  /// Is the user linked to IDP
  accountLinked        Boolean       @default(false)
  /// Full name
  fullName             String
  /// Email
  email                String
  /// Preferred language
  language             String?
  /// Creation date
  createdAt            DateTime      @default(now())
  /// Latest update date
  updatedAt            DateTime      @updatedAt
  /// When item was marked for deletion
  deletedAt            DateTime?
  /// Date of last activity
  lastActivity         DateTime      @default(now())
  /// Whether the user has admin access or not
  isAdmin              Boolean       @default(false)
  /// Has user accepted terms
  acceptedTerms        Boolean       @default(false)
  /// Arbitrary metadata from IDP
  metadata             Json          @default("{}")
  /// User memberships
  memberships          Membership[]
  /// User additional roles specific to elastic
  elasticRoles         ElasticRole[]
  /// Notifications that the user doesnt want to receive
  excludeNotifications String[]      @default([])
  /// Actions that were triggered by the user
  actions              Action[]

  @@index([id])
}
