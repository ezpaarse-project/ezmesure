/// A Kibana dashboard
model Dashboard {
  /// The ID of the dashboard
  id                    String               @id @default(cuid())
  /// The ID of the source dashboard, if different
  sourceDashboardId     String?
  /// The space where the source dashboard comes from
  sourceSpaceId         String?
  /// The dashboard definition, ie. the saved objects exported from Kibana
  data                  Json                 @default("[]")
  /// The dashboard tags, extracted from the Kibana export
  tags                  Json[]
  /// The Kibana version from which the dashboard was exported
  kibanaVersion         String?
  /// The dashboard name
  name                  String?
  /// The dashboard description
  description           String?
  /// Creation date
  createdAt             DateTime             @default(now())
  /// Latest update date
  updatedAt             DateTime             @updatedAt
  /// The ID of the collection that contains this dashboard
  collectionId          String?
  /// The collection that contains this dashboard
  collection            DashboardCollection? @relation(fields: [collectionId], references: [id])
}

/// A collection of dashboards
model DashboardCollection {
  /// The ID of the dashboard
  id          String                     @id @default(cuid())
  /// Name of the collection
  name        String
  /// Description of the collection
  description String?
  /// Creation date
  createdAt   DateTime                   @default(now())
  /// Latest update date
  updatedAt   DateTime                   @updatedAt
  /// The dashboards in the collection
  dashboards  Dashboard[]
  /// The spaces that include this collection
  spaces      SpaceDashboardCollection[]
}
